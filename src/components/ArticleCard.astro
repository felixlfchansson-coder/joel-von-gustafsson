---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const {
  title,
  description,
  date,
  category,
  image,
  imageAlt,
} = post.data;

const formattedDate = date.toLocaleDateString("sv-SE", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const href = `/blogg/${post.id}/`;
---

<article class="article-card">

  {
    image && (
      <a class="image-link" href={href}>
        <img
          src={image}
          alt={imageAlt ?? ""}
          loading="lazy"
        />
      </a>
    )
  }

  <div class="meta">
    <span class="category">{category}</span>

    <span class="separator">•</span>

    <time datetime={date.toISOString()}>
      {formattedDate}
    </time>
  </div>

  <h2>
    <a href={href}>
      {title}
    </a>
  </h2>

  <p class="description">
    {description}
  </p>

  <a class="read-more" href={href}>
    Läs mer →
  </a>

</article>


<style>
  .article-card {
    display: flex;
    flex-direction: column;
  }


  /* BILD */

  .image-link {
    display: block;

    margin-bottom: 1rem;

    overflow: hidden;
  }

  .image-link img {
    width: 100%;

    aspect-ratio: 16 / 10;

    object-fit: cover;

    border: 1px solid var(--border);

    transition: transform 200ms ease;
  }

  .image-link:hover img {
    transform: scale(1.02);
  }


  /* META */

  .meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;

    margin-bottom: 0.6rem;

    color: var(--text-muted);

    font-size: 0.72rem;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }

  .category {
    color: var(--accent);

    font-weight: bold;
  }

  .separator {
    color: var(--border);
  }


  /* TITEL */

  h2 {
    margin: 0;

    font-size: 1.55rem;

    font-weight: normal;

    line-height: 1.15;
  }

  h2 a {
    color: var(--text);

    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }


  /* BESKRIVNING */

  .description {
    margin: 0.8rem 0 1rem;

    color: var(--text-muted);

    font-size: 0.95rem;

    line-height: 1.55;
  }


  /* LÄS MER */

  .read-more {
    margin-top: auto;

    color: var(--accent);

    font-size: 0.75rem;

    font-weight: bold;

    letter-spacing: 0.08em;

    text-decoration: none;

    text-transform: uppercase;
  }

  .read-more:hover {
    text-decoration: underline;
  }
</style>