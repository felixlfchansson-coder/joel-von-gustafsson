---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
---

<BaseLayout
  title="Om mig | Joel von Gustafsson"
  description="Om Joel von Gustafsson – skribent, betraktare och oberoende tänkare."
>
  <div class="about-layout">
    <main class="about-main">

      <!-- HERO -->

      <header class="about-header">
        <span class="eyebrow">Om skribenten</span>

        <h1>Joel von Gustafsson</h1>

        <p class="role">
          Skribent. Betraktare. Oberoende tänkare.
        </p>

        <div class="portrait">
          <img
            src="/images/joel.png"
            alt="Joel von Gustafsson"
          />
        </div>

        <div class="opening">
          <p>
            Jag heter Joel von Gustafsson och har under större delen
            av mitt vuxna liv intresserat mig för historia, samhälle,
            vetenskap och frågor där den officiella förklaringen
            lämnar någonting kvar att fundera över.
          </p>

          <p>
            Jag är inte journalist.
          </p>

          <p>
            Jag är inte historiker.
          </p>

          <p>
            Jag är inte forskare.
          </p>

          <p class="opening-statement">
            <strong>
              Det innebär samtidigt att jag inte är beroende
              av någon av dessa branscher.
            </strong>
          </p>

          <p>
            Jag skriver för att förstå världen.
          </p>

          <p>
            Ibland upptäcker jag att jag haft fel.
          </p>

          <p>
            Det är inget problem.
          </p>

          <p class="almost-right">
            Det viktiga är att förstå varför jag nästan hade rätt.
          </p>
        </div>
      </header>


      <!-- FAKTARUTA -->

      <section class="fact-sheet">
        <div class="fact-heading">
          <div>
            <span class="small-heading">Personuppgifter</span>
            <h2>I korthet</h2>
          </div>

          <span class="document-number">JvG:00</span>
        </div>

        <dl class="facts">
          <div>
            <dt>Namn</dt>
            <dd>Joel von Gustafsson</dd>
          </div>

          <div>
            <dt>Yrke</dt>
            <dd>Skribent</dd>
          </div>

          <div>
            <dt>Utbildning</dt>
            <dd>Blandad</dd>
          </div>

          <div>
            <dt>Specialområde</dt>
            <dd>Samband</dd>
          </div>

          <div>
            <dt>Metod</dt>
            <dd>Läsning, observation och sunt förnuft</dd>
          </div>

          <div>
            <dt>Finansiering</dt>
            <dd>Egen</dd>
          </div>

          <div>
            <dt>Antal öppna flikar</dt>
            <dd>Varierar</dd>
          </div>

          <div>
            <dt>Politiskt oberoende</dt>
            <dd>Ja</dd>
          </div>

          <div class="farkost-fact">
            <dt>Farkostprincipen</dt>
            <dd>Nej</dd>
          </div>
        </dl>
      </section>


      <!-- BAKGRUND -->

      <section class="about-section">
        <span class="small-heading">Bakgrund</span>

        <h2>Min bakgrund</h2>

        <p>
          Jag har ingen formell akademisk utbildning inom de flesta
          ämnen jag skriver om.
        </p>

        <p>
          Däremot har jag under många år läst böcker, tidningar,
          uppslagsverk, forskningssammanfattningar, forum,
          myndighetssidor och ett stort antal dokument som jag
          hittat via Goggel.
        </p>

        <p>
          Jag har dessutom alltid haft lätt för att komma ihåg
          detaljer.
        </p>

        <p>
          Det är inte samma sak som en examen.
        </p>

        <blockquote>
          En detalj blir inte mindre sann för att personen som
          upptäcker den saknar examen.
        </blockquote>
      </section>


      <!-- VARFÖR SIDAN FINNS -->

      <section class="about-section">
        <span class="small-heading">Syfte</span>

        <h2>Varför den här sidan finns</h2>

        <p>
          Internet har gjort mer information tillgänglig för vanliga
          människor än någon tidigare generation haft tillgång till.
        </p>

        <p>
          Det är i grunden något fantastiskt.
        </p>

        <p>
          Men tillgång till information är inte samma sak som
          förståelse.
        </p>

        <p>
          Därför försöker jag gå tillbaka till källorna.
        </p>

        <p>
          Eller, när källorna är mycket långa, till sammanfattningen
          av källorna.
        </p>

        <p>
          I vissa fall rubriken.
        </p>

        <p class="quiet">
          Det beror på ämnet.
        </p>
      </section>


      <!-- PRINCIP -->

      <section class="method-box">
        <div class="method-heading">
          <div>
            <span class="small-heading">Arbetsprincip</span>
            <h2>Fyra nivåer av säkerhet</h2>
          </div>

          <span class="document-number">JvG:M01</span>
        </div>

        <p class="method-intro">
          Jag försöker alltid skilja mellan fyra saker:
        </p>

        <ol class="certainty-list">
          <li>
            <span class="number">01</span>
            <div>
              <strong>Vad jag vet</strong>
              <p>Sådant som går att kontrollera.</p>
            </div>
          </li>

          <li>
            <span class="number">02</span>
            <div>
              <strong>Vad jag tror</strong>
              <p>Slutsatser som verkar rimliga utifrån det jag vet.</p>
            </div>
          </li>

          <li>
            <span class="number">03</span>
            <div>
              <strong>Vad jag misstänker</strong>
              <p>
                Sådant där informationen ännu inte är tillräcklig
                för en säker slutsats.
              </p>
            </div>
          </li>

          <li>
            <span class="number">04</span>
            <div>
              <strong>Vad som vore märkligt om det visade sig stämma</strong>
              <p>
                En kategori som visat sig vara svårare att avgränsa
                än jag först trodde.
              </p>
            </div>
          </li>
        </ol>

        <p class="method-note">
          Gränsen mellan punkt tre och fyra kan ibland vara svår att dra.
        </p>
      </section>


      <!-- ATT HA FEL -->

      <section class="about-section">
        <span class="small-heading">Rättelser</span>

        <h2>Om att ha fel</h2>

        <p>
          Om jag upptäcker att jag haft fel ändrar jag texten
          eller skriver en ny.
        </p>

        <p>
          Att ändra sig är inte ett nederlag.
        </p>

        <p>
          Det är ett tecken på att undersökningen fungerade.
        </p>

        <p>
          Detta har bland annat inträffat i frågor om dinosaurier,
          historisk kronologi och vissa amerikanska militära områden.
        </p>

        <p>
          Jag betraktar inte detta som ett problem.
        </p>

        <blockquote>
          Ett felaktigt svar innebär inte automatiskt
          att frågan var fel.
        </blockquote>

        <p>
          Det är en viktig skillnad.
        </p>
      </section>


      <!-- KATEGORIER -->

      <section class="categories-section">
        <span class="small-heading">Ämnesområden</span>

        <h2>Vad jag skriver om</h2>

        <div class="category-list">
          <a href="/kategori/samhalle">
            <span class="category-name">Samhälle</span>
            <span class="category-description">
              Sådant vi förväntas acceptera som normalt innan någon
              hunnit fråga varför.
            </span>
          </a>

          <a href="/kategori/media">
            <span class="category-name">Media</span>
            <span class="category-description">
              Jag försökte granska medierna mer systematiskt.
              Det visade sig vara betydligt mer arbete än jag räknat med.
              Därför finns än så länge en text.
            </span>
          </a>

          <a href="/kategori/vetenskap">
            <span class="category-name">Vetenskap</span>
            <span class="category-description">
              Forskning, statistik och förstahandskällor.
              I vissa fall andrahandskällor som beskriver
              förstahandskällan tydligt.
            </span>
          </a>

          <a href="/kategori/historia">
            <span class="category-name">Historia</span>
            <span class="category-description">
              Händelser som redan inträffat och därför borde vara
              lättare att reda ut än de tydligen är.
            </span>
          </a>

          <a href="/kategori/betraktelser">
            <span class="category-name">Betraktelser</span>
            <span class="category-description">
              Saker jag lägger märke till. I efterhand har detta
              visat sig vara den bredaste kategorin.
            </span>
          </a>
        </div>

        <aside class="culture-note">
          <span class="small-heading">Tidigare plan</span>

          <p>
            Jag hade tidigare även planer på en kategori om kultur.
          </p>

          <p>
            <strong>Det blev för stort.</strong>
          </p>
        </aside>
      </section>


      <!-- SAKER JOEL TROR PÅ -->

      <section class="principles-section">
        <span class="small-heading">Grundprinciper</span>

        <h2>Saker jag tror på</h2>

        <div class="principles">
          <article>
            <span>01</span>
            <div>
              <h3>Källkritik</h3>
              <p>
                Särskilt när källan säger något annat än rubriken.
              </p>
            </div>
          </article>

          <article>
            <span>02</span>
            <div>
              <h3>Sunt förnuft</h3>
              <p>
                Inte som ersättning för fakta, utan som något man
                använder efter att man hittat de fakta som verkar relevanta.
              </p>
            </div>
          </article>

          <article>
            <span>03</span>
            <div>
              <h3>Att ändra sig</h3>
              <p>
                Jag har gjort det flera gånger.
              </p>
            </div>
          </article>

          <article>
            <span>04</span>
            <div>
              <h3>Att ställa frågor</h3>
              <p>
                Även när frågan redan har ett svar.
                Svaret kan fortfarande vara intressant.
              </p>
            </div>
          </article>

          <article>
            <span>05</span>
            <div>
              <h3>Årtal</h3>
              <p>
                Ett årtal kan inte ha en åsikt.
              </p>
            </div>
          </article>

          <article>
            <span>06</span>
            <div>
              <h3>Miniräknare</h3>
              <p>
                Flera stora historiska problem blir mindre
                när man dividerar.
              </p>
            </div>
          </article>

          <article>
            <span>07</span>
            <div>
              <h3>Goggel</h3>
              <p>
                Man måste bara veta vad man letar efter.
              </p>
            </div>
          </article>

          <article>
            <span>08</span>
            <div>
              <h3>Anteckningsblock</h3>
              <p>
                Mönster är lättare att upptäcka när man ritar pilar.
              </p>
            </div>
          </article>
        </div>
      </section>


      <!-- FARKOSTPRINCIPEN -->

      <section class="farkost-section">
        <div class="farkost-heading">
          <span class="small-heading">Klargörande</span>

          <span class="status">Ärendet avslutat</span>
        </div>

        <h2>Om Farkostprincipen</h2>

        <p>
          Jag hade ursprungligen inte tänkt ta upp detta här.
        </p>

        <p>
          Men eftersom frågan återkommer vill jag klargöra
          min ståndpunkt.
        </p>

        <p class="farkost-statement">
          Jag tror inte på Farkostprincipen.
        </p>

        <p>
          Att vissa av mina senare texter råkar innehålla begrepp som:
        </p>

        <ul>
          <li>riktning</li>
          <li>förflyttning</li>
          <li>startpunkt</li>
          <li>destination</li>
          <li>transport</li>
          <li>system</li>
        </ul>

        <p>
          har ingen betydelse.
        </p>

        <p>
          Dessa är vanliga ord.
        </p>

        <p>
          Jag har kontrollerat detta.
        </p>

        <p>
          Farkostprincipen är avslutad.
        </p>

        <p>
          Jag kommer inte kommentera saken ytterligare.
        </p>

        <p class="updated">
          Senast uppdaterad efter undersökningen av kassaköer.
        </p>
      </section>


      <!-- KONTAKT -->

      <section class="contact-section">
        <span class="small-heading">Kontakt</span>

        <h2>Tips, rättelser och dokument</h2>

        <p>
          Tips, rättelser och dokument tas emot.
        </p>

        <p>
          Om du anser att jag har fel får du gärna skriva.
        </p>

        <p class="exact">
          <strong>Ange gärna exakt vilken del.</strong>
        </p>

        <p>
          Jag tar även emot tips om samband som inte verkar
          ha uppmärksammats tidigare.
        </p>

        <p>
          Skicka helst källor.
        </p>

        <p>
          Skärmdumpar accepteras om källan inte längre finns kvar,
          vilket i sig naturligtvis kan vara relevant.
        </p>

        <div class="contact-note">
          Meddelanden som endast innehåller
          <em>”läs hela studien”</em>
          besvaras i mån av tid.
        </div>
      </section>


      <!-- MANIFEST -->

      <footer class="manifest">
        <span class="small-heading">Till sist</span>

        <h2>Varför jag fortsätter</h2>

        <div class="manifest-text">
          <p>
            Jag gör inte anspråk på att alltid ha rätt.
          </p>

          <p>
            Det gör mig misstänksam när människor gör det.
          </p>

          <p>
            Jag försöker läsa.
          </p>

          <p>
            Jämföra.
          </p>

          <p>
            Räkna.
          </p>

          <p>
            Observera.
          </p>

          <p>
            Och framför allt ställa den fråga som ibland glöms bort:
          </p>

          <blockquote>
            ”Vänta lite. Hur hänger det här egentligen ihop?”
          </blockquote>

          <p>
            Ibland visar det sig att saker inte hänger ihop alls.
          </p>

          <p>
            Det är också ett resultat.
          </p>

          <p>
            Ibland visar det sig att förklaringen redan varit känd
            i flera hundra år.
          </p>

          <p>
            Det har hänt.
          </p>

          <p>
            Och ibland hittar man något som man inte riktigt
            kan släppa.
          </p>

          <p>
            Något som fortsätter dyka upp i andra sammanhang
            trots att man redan har avfärdat det.
          </p>

          <p class="pause">...</p>

          <p class="final-denial">
            Det här handlar inte om Farkostprincipen.
          </p>
        </div>

        <div class="signature">
          <strong>Joel von Gustafsson</strong>
          <span>Skribent och oberoende betraktare</span>
        </div>

        <p class="independent">
          Oberoende sedan starten.
        </p>
      </footer>

    </main>

    <Sidebar />
  </div>
</BaseLayout>


<style>
  .about-layout {
    width: min(var(--content-width), calc(100% - 3rem));
    margin: 3.5rem auto 5rem;

    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 4rem;

    align-items: start;
  }

  .about-main {
    min-width: 0;
  }

  .eyebrow,
  .small-heading {
    display: block;
    margin-bottom: 0.65rem;

    color: var(--accent);

    font-size: 0.72rem;
    font-weight: bold;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }


  /* HERO */

  .about-header {
    margin-bottom: 4rem;
  }

  .about-header h1 {
    max-width: 760px;

    margin: 0;

    font-size: clamp(3.5rem, 7vw, 6rem);
    font-weight: normal;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .role {
    margin: 1.25rem 0 2rem;

    color: var(--text-muted);

    font-size: 1.25rem;
    font-style: italic;
  }

  .portrait {
    margin: 2rem 0 2.5rem;
    padding: 0.6rem;

    border: 1px solid var(--border);

    background: rgba(255, 255, 255, 0.2);
  }

  .portrait img {
    width: 100%;
    max-height: 520px;

    object-fit: cover;
    object-position: center 25%;

    filter: sepia(0.12) contrast(1.03);
  }

  .opening {
    max-width: 680px;

    font-size: 1.13rem;
    line-height: 1.72;
  }

  .opening p {
    margin: 0.9rem 0;
  }

  .opening-statement {
    margin: 1.7rem 0 !important;
    padding: 1rem 0 1rem 1.4rem;

    border-left: 4px solid var(--accent);
  }

  .almost-right {
    margin-top: 2rem !important;

    font-size: 1.35rem;
    font-style: italic;
  }


  /* FAKTARUTA */

  .fact-sheet {
    margin-bottom: 4rem;

    border-top: 4px solid var(--accent);
    border-bottom: 1px solid var(--border);

    background: rgba(104, 27, 22, 0.035);
  }

  .fact-heading,
  .method-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 2rem;

    padding: 1.4rem 1.6rem;

    border-bottom: 1px solid var(--border);
  }

  .fact-heading h2,
  .method-heading h2 {
    margin: 0;

    font-size: 1.8rem;
    font-weight: normal;
    line-height: 1.15;
  }

  .document-number {
    color: var(--text-muted);

    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .facts {
    margin: 0;
  }

  .facts > div {
    display: grid;
    grid-template-columns: 180px 1fr;

    gap: 1.5rem;

    padding: 0.85rem 1.6rem;

    border-bottom: 1px solid rgba(207, 194, 174, 0.65);
  }

  .facts > div:last-child {
    border-bottom: 0;
  }

  .facts dt {
    color: var(--text-muted);

    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0;
  }

  .farkost-fact dd {
    font-weight: bold;
  }


  /* VANLIGA AVSNITT */

  .about-section,
  .categories-section,
  .principles-section,
  .contact-section {
    max-width: 700px;

    margin-bottom: 4.5rem;
  }

  .about-section h2,
  .categories-section > h2,
  .principles-section > h2,
  .contact-section h2,
  .manifest > h2 {
    margin: 0 0 1.5rem;

    font-size: 2.25rem;
    font-weight: normal;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .about-section p,
  .contact-section p {
    margin: 1rem 0;

    font-size: 1.08rem;
    line-height: 1.7;
  }

  .about-section blockquote {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;

    border-left: 4px solid var(--accent);

    background: rgba(104, 27, 22, 0.035);

    color: #51463d;

    font-size: 1.2rem;
    font-style: italic;
    line-height: 1.6;
  }

  .quiet {
    color: var(--text-muted);

    font-size: 0.9rem !important;
    font-style: italic;
  }


  /* FYRA NIVÅER */

  .method-box {
    max-width: 720px;

    margin-bottom: 4.5rem;

    border-top: 4px solid var(--accent);
    border-bottom: 1px solid var(--border);

    background: rgba(104, 27, 22, 0.035);
  }

  .method-intro {
    margin: 0;
    padding: 1.3rem 1.6rem 0;

    line-height: 1.6;
  }

  .certainty-list {
    margin: 0;
    padding: 1rem 1.6rem 1.5rem;

    list-style: none;
  }

  .certainty-list li {
    display: grid;
    grid-template-columns: 45px 1fr;

    gap: 1rem;

    padding: 1rem 0;

    border-bottom: 1px solid var(--border);
  }

  .certainty-list li:last-child {
    border-bottom: 0;
  }

  .certainty-list .number {
    color: var(--accent);

    font-size: 0.75rem;
    font-weight: bold;
  }

  .certainty-list p {
    margin: 0.25rem 0 0;

    color: var(--text-muted);

    font-size: 0.9rem;
    line-height: 1.5;
  }

  .method-note {
    margin: 0;
    padding: 1rem 1.6rem;

    border-top: 1px solid var(--border);

    color: var(--text-muted);

    font-size: 0.85rem;
    font-style: italic;
  }


  /* KATEGORIER */

  .category-list {
    border-top: 3px solid var(--accent);
  }

  .category-list a {
    display: grid;
    grid-template-columns: 150px 1fr;

    gap: 1.5rem;

    padding: 1.25rem 0;

    border-bottom: 1px solid var(--border);

    text-decoration: none;
  }

  .category-list a:hover .category-name {
    color: var(--accent);
  }

  .category-name {
    font-size: 1.15rem;
    font-weight: bold;
  }

  .category-description {
    color: var(--text-muted);

    font-size: 0.92rem;
    line-height: 1.55;
  }

  .culture-note {
    margin-top: 2rem;
    padding: 1.2rem 1.4rem;

    border-left: 3px solid var(--border);

    color: var(--text-muted);
  }

  .culture-note p {
    margin: 0.4rem 0;
  }


  /* PRINCIPER */

  .principles {
    border-top: 3px solid var(--accent);
  }

  .principles article {
    display: grid;
    grid-template-columns: 45px 1fr;

    gap: 1rem;

    padding: 1.2rem 0;

    border-bottom: 1px solid var(--border);
  }

  .principles article > span {
    color: var(--accent);

    font-size: 0.72rem;
    font-weight: bold;
  }

  .principles h3 {
    margin: 0 0 0.25rem;

    font-size: 1.15rem;
  }

  .principles p {
    margin: 0;

    color: var(--text-muted);

    font-size: 0.92rem;
    line-height: 1.55;
  }


  /* FARKOSTPRINCIPEN */

  .farkost-section {
    max-width: 700px;

    margin: 5rem 0;
    padding: 1.75rem 2rem 2rem;

    border: 1px solid var(--border);
    border-top: 5px solid var(--accent);

    background: rgba(104, 27, 22, 0.04);
  }

  .farkost-heading {
    display: flex;
