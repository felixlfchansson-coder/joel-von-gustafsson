---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Sidebar from "../../components/Sidebar.astro";

const posts = (await getCollection("blog"))
  .filter(
    (post) =>
      !post.data.draft &&
      post.data.category === "Media"
  )
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime()
  );
---

<BaseLayout
  title="Media | Joel von Gustafsson"
  description="Rubriker, nyhetsrapportering och det som ibland är minst lika intressant: det som inte sägs."
>
  <div class="category-layout">

    <main class="category-main">

      <header class="category-header">

        <span class="eyebrow">
          Ämnesområde
        </span>

        <h1>Media</h1>

        <p class="intro">
          Rubriker, nyhetsrapportering och det som ibland är
          minst lika intressant: det som inte sägs.
        </p>

        <p class="editorial-note">
          Jag läser medierna varje dag.
          Ibland även artiklarna.
        </p>

      </header>


      {
        posts.length > 0 ? (
          <section class="articles">

            <div class="section-heading">
              <span>Senaste inom Media</span>

              <span class="count">
                {posts.length} {posts.length === 1 ? "text" : "texter"}
              </span>
            </div>

            <div class="article-grid">
              {
                posts.map((post) => (
                  <ArticleCard post={post} />
                ))
              }
            </div>

          </section>
        ) : (
          <section class="empty">
            <p>
              Inga texter har publicerats här ännu.
            </p>

            <p>
              Frånvaron av rapportering är naturligtvis
              inte samma sak som frånvaron av något att rapportera.
            </p>
          </section>
        )
      }

    </main>


    <Sidebar />

  </div>
</BaseLayout>


<style>
  .category-layout {
    width: min(
      var(--content-width),
      calc(100% - 3rem)
    );

    margin: 3.5rem auto 5rem;

    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;

    gap: 4rem;

    align-items: start;
  }


  /* SIDHUVUD */

  .category-header {
    max-width: 760px;

    margin-bottom: 3rem;
    padding-bottom: 2.5rem;

    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    display: block;

    margin-bottom: 0.6rem;

    color: var(--accent);

    font-size: 0.75rem;
    font-weight: bold;

    letter-spacing: 0.14em;

    text-transform: uppercase;
  }

  .category-header h1 {
    margin: 0;

    font-size: clamp(3.5rem, 7vw, 6rem);
    font-weight: normal;

    line-height: 0.95;

    letter-spacing: -0.045em;
  }

  .intro {
    max-width: 700px;

    margin: 1.4rem 0 0;

    color: var(--text);

    font-size: 1.3rem;
    font-style: italic;

    line-height: 1.55;
  }

  .editorial-note {
    max-width: 650px;

    margin: 1rem 0 0;

    color: var(--text-muted);

    font-size: 1rem;

    line-height: 1.6;
  }


  /* ARTIKELSEKTION */

  .articles {
    margin-top: 2rem;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 1rem;

    margin-bottom: 2rem;
    padding: 0.7rem 0;

    border-top: 3px solid var(--accent);
    border-bottom: 1px solid var(--border);
  }

  .section-heading > span:first-child {
    font-size: 0.8rem;
    font-weight: bold;

    letter-spacing: 0.1em;

    text-transform: uppercase;
  }

  .count {
    color: var(--text-muted);

    font-size: 0.75rem;
    font-style: italic;
  }


  /* ARTIKLAR */

  .article-grid {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 3rem 2rem;
  }


  /* TOM KATEGORI */

  .empty {
    padding: 2rem 0 4rem;

    color: var(--text-muted);

    font-style: italic;
  }

  .empty p {
    margin: 0.3rem 0;
  }


  /* RESPONSIVE */

  @media (max-width: 900px) {
    .category-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 650px) {
    .category-layout {
      width: min(
        var(--content-width),
        calc(100% - 2rem)
      );

      margin-top: 2rem;
    }

    .category-header h1 {
      font-size: 3.5rem;
    }

    .intro {
      font-size: 1.1rem;
    }

    .article-grid {
      grid-template-columns: 1fr;
    }
  }
</style>